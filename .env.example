# 未配置云端时，仅允许 localhost 使用本地持久化；不向公网开放个人数据。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 配置云端后启用 Supabase 邮件登录。服务角色密钥仅留在 Next.js 服务端与 GitHub Actions。
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen-vl-plus
# Python monitor 用于调用受保护的服务端净值同步入口
APP_URL=http://127.0.0.1:3000
MONITOR_SECRET=
# 32 字节随机 hex 密钥，用于加密云端用户通知配置
CHANNEL_ENCRYPTION_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TEMPLATE_ID=
WECHAT_TEMPLATE_FIELDS={"thing1":"title","date2":"date","thing3":"notice"}
WECHAT_MINIPROGRAM_STATE=developer
WECHAT_OFFICIAL_APP_ID=
WECHAT_OFFICIAL_APP_SECRET=
WECHAT_OFFICIAL_TEMPLATE_ID=
WECHAT_OFFICIAL_TEMPLATE_FIELDS={"thing1":"title","time2":"date","thing3":"notice"}
